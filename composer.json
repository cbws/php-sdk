{
    "name": "cbws/sdk",
    "type": "library",
    "license": "Apache-2.0",
    "description": "Client libraries for the CBWS platform",
    "authors": [
        {
            "name": "CBWS",
            "email": "support@cbws.nl"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "league/oauth2-client": "^2.6",
        "symfony/yaml": "^6.0 || ^7.0",
        "lcobucci/jwt": "^5.0",
        "google/common-protos": "^4.0",
        "ramsey/uuid": "^4.0",
        "cbws/php-cbws-grpc": ">=0.98 <1",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-grpc": "Calls the API over native gRPC instead of gRPC-Web"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.71",
        "phpstan/phpstan-phpunit": "^2.0",
        "colinodell/psr-testlogger": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Cbws\\Sdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbws\\Sdk\\Tests\\": "tests"
        }
    },
    "scripts-aliases": {
        "phpstan": ["stan", "analyze"]
    },
    "scripts": {
        "test": [
            "phpunit --testsuite Unit"
        ],
        "test-integration": [
            "phpunit --testsuite Integration"
        ],
        "lint": [
            "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix --show-progress dots"
        ],
        "phpstan": [
            "phpstan analyse --memory-limit=-1"
        ]
    }
}
